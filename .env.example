# Copy this file to .env.local and fill in real values locally.
# NEVER commit .env.local or paste keys into chat.
# See README.md → "Environment variables: kaunsa variable kahan jaata hai".

# ---------------------------------------------------------------------------
# Next.js app (.env.local locally, Vercel → Project → Settings → Environment Variables in production)
# ---------------------------------------------------------------------------

# Written automatically by `npx convex dev`. Don't edit by hand.
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment-name.convex.site

# Vercel AI Gateway (all model calls go through it). Leave empty to use the
# keyword "demo planner" instead of a real model. On Vercel you can instead rely
# on VERCEL_OIDC_TOKEN (set automatically; `vercel env pull` locally).
AI_GATEWAY_API_KEY=
# Any tool-capable Gateway model id, e.g. anthropic/claude-sonnet-5.5, anthropic/claude-haiku-5.5
AI_MODEL=anthropic/claude-sonnet-5.5

# --- Remote browser -------------------------------------------------------
# Option A (default): your own self-hosted browser worker (`bun run worker`).
# The same secret goes in the app's env and the worker's env. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BROWSER_WORKER_URL=http://127.0.0.1:8787
# Optional: URL the user's browser uses for the live view, if different (e.g. https://browser.example.com)
BROWSER_WORKER_PUBLIC_URL=
BROWSER_WORKER_SECRET=
# Worker-only settings
WORKER_PORT=8787
WORKER_HOST=127.0.0.1
WORKER_MAX_SESSIONS=3
WORKER_IDLE_SECONDS=600
# Optional: Chrome/Chromium binary (auto-detected on macOS, or `npx playwright-core install chromium`)
BROWSER_EXECUTABLE_PATH=
# true inside Docker/Linux containers
WORKER_NO_SANDBOX=false

# Option B (optional): Browserbase hosted browsers instead of the worker.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_KEEP_ALIVE=true
BROWSERBASE_REGION=

# auto = worker if configured, else Browserbase, else demo | demo | browserbase
BROWSER_MODE=auto

# Where the browser opens "the demo website".
# Self-hosted locally: http://localhost:3000/sample works (only /sample and /_next are allowed on that origin).
# Browserbase: needs a public URL (tunnel or Vercel), localhost won't work.
DEMO_SITE_URL=http://localhost:3000/sample

# Comma-separated domain allowlist (subdomains included). "*" disables it
# (private/local addresses stay blocked).
ALLOWED_DOMAINS=agent.magicwebs.ai,magicwebs.ai,youtube.com,example.com,wikipedia.org

# Limits (optional; defaults shown)
AGENT_MAX_STEPS=15
AGENT_MAX_RUN_SECONDS=150
AGENT_MAX_OUTPUT_TOKENS=1500
AGENT_MAX_TOTAL_TOKENS=200000
AGENT_TOOL_TIMEOUT_SECONDS=45
BROWSER_SESSION_TIMEOUT_SEC=900
BROWSER_MAX_TABS=6

# ---------------------------------------------------------------------------
# Convex deployment env (NOT in this file — set with `npx convex env set` or the Convex dashboard)
# ---------------------------------------------------------------------------
# JWT_PRIVATE_KEY, JWKS   -> Convex Auth signing keys (see README "Auth keys")
# SITE_URL                -> http://localhost:3000 in dev, your production URL in prod
# BROWSERBASE_API_KEY     -> optional, lets the cleanup cron release idle sessions
# BROWSERBASE_PROJECT_ID  -> optional, same as above
